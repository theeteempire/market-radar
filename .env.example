# ===== رادار السوق · إعدادات البيئة =====
# انسخ هذا الملف إلى .env ثم عدّل القيم. لا تضع .env في مستودع عام.

# واجهة الشبكة
# 127.0.0.1 = محلي فقط (الافتراضي والآمن). 0.0.0.0 = متاح لكل الشبكة بلا مصادقة.
HOST=127.0.0.1
PORT=8787

# فترات التحديث (مللي ثانية)
CRYPTO_POLL_MS=1000
YAHOO_POLL_MS=20000
# مقياس فترات الأخبار: 100 = الافتراضي، 50 = أسرع، 200 = أبطأ
NEWS_POLL_SCALE=100

# ===== خط معالجة الأخبار =====
# 1 = ترجمة العناوين والملخصات المهمة تلقائيًا
NEWS_PIPELINE_ENABLED=1
TRANSLATE_ENABLED=1
# auto = العناوين دائمًا + الملخصات للعاجل/المهم فقط، all = كل الملخصات، off = العناوين فقط
TRANSLATE_SUMMARIES=auto
# 1 = جلب صورة og:image من صفحة الخبر عند غياب صورة في الخلاصة
IMAGE_ENRICH_ENABLED=1
# فترة سحب Mastodon (وسوم عامة فقط)
MASTODON_POLL_MS=180000

# ===== X / Twitter (اختياري) =====
# يتطلب حساب مطوّر و API v2 (البحث الحديث). بدون توكن يبقى X معطّلًا.
# لا يتم كشط X أو استخدام واجهات غير رسمية.
X_BEARER_TOKEN=
X_POLL_MS=300000

# ===== Telegram (اختياري) =====
# أنشئ بوتًا عبر @BotFather ثم ضع التوكن ومعرّف المحادثة.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# high = التنبيهات الحرجة فقط، medium = الحرجة والمهمة
TELEGRAM_MIN_SEVERITY=high

# ===== تشخيص =====
# 1 = تعطيل كل مزوّدي البيانات (لاختبار الواجهة فقط)
DISABLE_PROVIDERS=0
# 1 = طباعة تفاصيل الطلبات
DEBUG=0
